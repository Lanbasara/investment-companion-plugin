{
  "capabilities": {
    "investment_evidence_update": {
      "errors": [
        "capability.input.invalid",
        "capability.output.invalid"
      ],
      "input_schema": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "claims": { "items": { "type": "string" }, "type": "array" },
              "content": { "type": "string" },
              "evidence_type": {
                "enum": ["observed_fact", "official_disclosure", "validated_analysis", "predictive_signal"],
                "type": "string"
              },
              "first_known_at": { "type": "string" },
              "metadata": { "additionalProperties": true, "type": "object" },
              "observed_at": { "type": "string" },
              "operation": { "const": "publish_source", "type": "string" },
              "published_at": { "type": "string" },
              "source": { "type": "string" },
              "source_group": { "type": "string" },
              "subject": { "additionalProperties": true, "type": "object" },
              "supersedes": { "type": "string" },
              "url": { "type": "string" }
            },
            "required": ["operation", "subject", "source", "source_group", "first_known_at", "observed_at", "claims", "evidence_type"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "asset_id": { "type": "string" },
              "currency": { "type": "string" },
              "metadata": { "additionalProperties": true, "type": "object" },
              "metric": { "type": "string" },
              "observed_at": { "type": "string" },
              "operation": { "const": "market_snapshot", "type": "string" },
              "quality": {
                "enum": ["healthy", "stale", "partial", "conflicting", "unauthorized", "failed", "unknown"],
                "type": "string"
              },
              "source": { "type": "string" },
              "value": {}
            },
            "required": ["operation", "asset_id", "metric", "value", "observed_at", "source"],
            "type": "object"
          }
        ]
      },
      "invariants": [
        "research.evidence_validation_thesis_never_auto_action/v1"
      ],
      "level": "workflow_required",
      "rationale": "research-investment freezes every material source with type, lineage and event timing; decide-investment freezes the market observations used at decision time. Neither workflow treats Evidence as a Decision or trade.",
      "required_operations": {
        "market_snapshot": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "asset_id", "schema": { "type": "string" } },
            { "path": "metric", "schema": { "type": "string" } },
            { "path": "value_text", "schema": { "type": "string" } },
            { "path": "observed_at", "schema": { "type": "string" } },
            { "path": "source", "schema": { "type": "string" } },
            { "path": "quality", "schema": { "type": "string" } }
          ]
        },
        "publish_source": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "kind", "schema": { "const": "investment_evidence", "type": "string" } },
            { "path": "schema_version", "schema": { "const": "investment-companion.evidence/v1", "type": "string" } },
            { "path": "manifest", "schema": { "type": "object" } },
            { "path": "content_hash", "schema": { "type": "string" } },
            { "path": "status", "schema": { "enum": ["ready", "superseded"], "type": "string" } }
          ]
        }
      },
      "required_outputs": [],
      "workflows": ["decide-investment", "research-investment"]
    },
    "investment_opportunity_update": {
