              "outcome": { "const": "promoted", "type": "string" },
              "owner": { "type": "string" },
              "reason": { "type": "string" },
              "result_refs": { "items": { "type": "string" }, "type": "array" }
            },
            "required": ["operation", "item_id", "outcome", "reason", "result_refs", "opportunity_id"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "item_id": { "type": "string" },
              "operation": { "const": "research_complete", "type": "string" },
              "outcome": { "const": "rejected", "type": "string" },
              "owner": { "type": "string" },
              "reason": { "type": "string" },
              "result_refs": { "items": { "type": "string" }, "type": "array" }
            },
            "required": ["operation", "item_id", "outcome", "reason"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "item_id": { "type": "string" },
              "next_check_at": { "type": "string" },
              "operation": { "const": "research_complete", "type": "string" },
              "outcome": { "const": "monitoring", "type": "string" },
              "owner": { "type": "string" },
              "reason": { "type": "string" },
              "result_refs": { "items": { "type": "string" }, "type": "array" }
            },
            "required": ["operation", "item_id", "outcome", "reason", "next_check_at"],
            "type": "object"
          }
