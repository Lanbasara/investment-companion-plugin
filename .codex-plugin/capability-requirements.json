      "rationale": "operate-investment-program creates research questions, advances Opportunities one stage at a time, claims persistent Research Work, explicitly dispositions every frozen candidate, and completes full research as promoted, rejected or time-bounded monitoring.",
      "required_operations": {
        "create": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "program_id", "schema": { "type": "string" } },
            { "path": "subject", "schema": { "type": "object" } },
            { "path": "stage", "schema": { "const": "observed", "type": "string" } },
            { "path": "status", "schema": { "const": "active", "type": "string" } },
            { "path": "version", "schema": { "type": "integer" } }
          ]
        },
        "research_complete": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "status", "schema": { "enum": ["completed", "rejected", "monitoring"], "type": "string" } },
            { "path": "result_refs", "schema": { "type": "array" } },
            { "path": "disposition.outcome", "schema": { "enum": ["promoted", "rejected", "monitoring"], "type": "string" } },
            { "path": "opportunity_id", "schema": { "type": ["string", "null"] } },
            { "path": "next_check_at", "schema": { "type": ["string", "null"] } }
          ]
        },
        "transition": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "stage", "schema": { "enum": ["observed", "researching", "qualified", "actionable"], "type": "string" } },
            { "path": "status", "schema": { "enum": ["active", "rejected", "expired", "closed"], "type": "string" } },
            { "path": "version", "schema": { "type": "integer" } },
            { "path": "qualification", "schema": { "type": "object" } },
            { "path": "research_validation", "schema": { "type": ["object", "null"] } }
          ]
        },
        "triage_complete": {
          "required_outputs": [
            { "path": "item.id", "schema": { "type": "string" } },
            { "path": "item.status", "schema": { "const": "completed", "type": "string" } },
            { "path": "children", "schema": { "type": "array" } }
          ]
        },
        "work_claim": {
          "required_outputs": [
            { "path": "id", "schema": { "type": "string" } },
            { "path": "status", "schema": { "const": "leased", "type": "string" } },
            { "path": "lease_owner", "schema": { "type": "string" } },
            { "path": "lease_until", "schema": { "type": "string" } },
            { "path": "due_at", "schema": { "type": "string" } }
          ]
        }
