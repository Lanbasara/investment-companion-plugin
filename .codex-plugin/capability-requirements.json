            { "path": "id", "schema": { "type": "string" } },
            { "path": "status", "schema": { "const": "confirmed", "type": "string" } },
            { "path": "entry_type", "schema": { "const": "reversal", "type": "string" } },
            { "path": "reversal_of", "schema": { "type": "string" } }
          ]
        }
      },
